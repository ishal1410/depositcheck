# SerpApi private API key - serpapi.com dashboard, "Your Private API Key"
SERPAPI_KEY=

# Vercel Blob read/write token - created with the Blob store, free on Hobby
BLOB_READ_WRITE_TOKEN=

# Public hostname of the Vercel Blob store, e.g. abc123.public.blob.vercel-storage.com
# Only images on this host may be sent to Google Lens - an open value turns
# /api/analyze into a free reverse-image-search proxy paid out of our quota.
BLOB_PUBLIC_HOST=

# HMAC secret for upload tokens - any long random string, e.g. openssl rand -hex 32
# /api/analyze deletes the blob it is given, so a URL alone must not be authority.
UPLOAD_TOKEN_SECRET=

# Shared secret for the daily cleanup cron - any long random string.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET` once this is set
# on the project. /api/cleanup deletes abandoned uploads, so with no secret it
# refuses every request rather than running unauthenticated.
CRON_SECRET=
